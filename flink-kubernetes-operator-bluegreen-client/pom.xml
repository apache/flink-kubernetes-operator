<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-kubernetes-operator-parent</artifactId>
        <version>1.17-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>flink-kubernetes-operator-bluegreen-client</artifactId>
    <name>Flink Kubernetes BlueGreen Deployment Client</name>

    <properties>
        <surefire.module.config>
            <!-- required by Kryo/chill ArraysAsListSerializer in test harness -->
            --add-opens=java.base/java.util=ALL-UNNAMED
        </surefire.module.config>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-kubernetes-operator-api</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
            <!-- The api is built against the operator's Flink version. Excluding its Flink
                 dependencies makes every Flink jar follow ${flink.version}, so a build with
                 -Dflink.version=<2.x> does not mix Flink 1.x and 2.x jars on the classpath. -->
            <exclusions>
                <exclusion>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Required by GateInjectorExecutor to detect SQL jobs via RowDataSerializer -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <version>${flink.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- compile scope: Flink 2.x relocated StreamGraph/StreamNode/StreamEdge/ProcessOperator/
             SimpleOperatorFactory/ProcessFunction/TimerService from flink-streaming-java into
             flink-runtime. GateInjectorExecutor + the gate ProcessFunctions need them at compile
             time. Harmless on Flink 1.x (those classes are also reachable via flink-streaming-java). -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-runtime</artifactId>
            <version>${flink.version}</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-metrics-core</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Per-Flink-major artifact selection. The default (first-pass) build produces the Flink 1.x
          jar with no classifier. Invoking with -Dflink.version=<2.x> -Dbluegreen.client.classifier=flink2
          rebuilds the same source against Flink 2.x and publishes it under the 'flink2' classifier, so
          one source tree yields both per-major artifacts. The source is cross-major compatible (see the
          getInteger note in GateInjectorExecutor); the jars are not interchangeable at runtime because
          they link against version-specific Flink internals, hence separate artifacts. Consumers depend
          on the classifier matching their job's Flink version (no classifier = 1.x, flink2 = 2.x).
        -->
        <profile>
            <id>bluegreen-client-classifier</id>
            <activation>
                <property>
                    <name>bluegreen.client.classifier</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <classifier>${bluegreen.client.classifier}</classifier>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
